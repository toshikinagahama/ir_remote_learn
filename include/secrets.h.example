#ifndef SECRETS_H
#define SECRETS_H

// このファイルをコピーして include/secrets.h を作成し、
// AWS CLIで発行した実際の証明書・鍵に置き換える。
//
//   aws iot create-thing --thing-name <thing-name>
//   aws iot create-keys-and-certificate --set-as-active \
//       --certificate-pem-outfile device-cert.pem.crt \
//       --private-key-outfile device-private.pem.key
//   aws iot create-policy --policy-name <policy-name> --policy-document file://policy.json
//   aws iot attach-policy --policy-name <policy-name> --target <certificateArn>
//   aws iot attach-thing-principal --thing-name <thing-name> --principal <certificateArn>
//   aws iot describe-endpoint --endpoint-type iot:Data-ATS
//
// Root CA (Amazon Root CA 1): https://www.amazontrust.com/repository/AmazonRootCA1.pem

#define AWS_IOT_ENDPOINT "your-endpoint-ats.iot.<region>.amazonaws.com"
#define AWS_IOT_THING_NAME "your-thing-name"

static const char AWS_CERT_CA[] PROGMEM = R"EOF(
-----BEGIN CERTIFICATE-----
(Amazon Root CA 1 の内容をここに貼り付け)
-----END CERTIFICATE-----
)EOF";

static const char AWS_CERT_CRT[] PROGMEM = R"EOF(
-----BEGIN CERTIFICATE-----
(device-cert.pem.crt の内容をここに貼り付け)
-----END CERTIFICATE-----
)EOF";

static const char AWS_CERT_PRIVATE[] PROGMEM = R"EOF(
-----BEGIN RSA PRIVATE KEY-----
(device-private.pem.key の内容をここに貼り付け)
-----END RSA PRIVATE KEY-----
)EOF";

#endif // SECRETS_H
